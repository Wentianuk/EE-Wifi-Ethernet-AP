#!/bin/sh /etc/rc.common

START=99
STOP=10

USE_PROCD=1

PROG="/usr/bin/python3"
AGENT="/usr/share/ee-wifi-autologin/ee_wifi_autologin.py"
CONFIG="/etc/ee-wifi-autologin.json"

start_service() {
	if [ ! -f "$CONFIG" ]; then
		logger -t ee-wifi-autologin "Config $CONFIG not found; refusing to start"
		return 1
	fi

	procd_open_instance
	procd_set_param command "$PROG" "$AGENT" --config "$CONFIG" --loop
	procd_set_param respawn 300 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger ee-wifi-autologin
}
